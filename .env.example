# Copy to .env and fill in. Do not commit .env.

# Supabase keys (browser). API host is chosen in src/integrations/supabase/client.ts:
#   dev  → https://YOUR_PROJECT_REF.supabase.co
#   prod → https://db.sageteach.top (Cloudflare proxy to Supabase)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy name:
# VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-only (TanStack server functions, CI, host env — not VITE_)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional: admin client — never expose to browser
# SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek — browser (SPA); prefer Edge proxy in production
VITE_DEEPSEEK_API_KEY=
# Server / Edge only (optional legacy)
DEEPSEEK_API_KEY=
# LOVABLE_API_KEY=

# Cloudflare Workers (Dashboard → sageteach → Settings → Variables and Secrets)
# Mirror the server-side names above so SSR / server functions can call Supabase & AI.
# VITE_* are baked in at `npm run build`; set them in the Pages/Workers build environment too.
